# .gitignore

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Environment variables and secrets
.env
.env.local
config/ai_config.json
config/github_config.json
node_modules/

# OS
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.bak
*.swp
~*

# Model files
*.pt
*.pth
*.onnx
*.h5
*.bin

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data (uncomment if you don't want to commit large data files)
# data/raw/*.json
# data/training/**/*.json

# Reports (generated files)
# data/analyzed/
# data/reports/

# Local-only entry points (start-fresh.bat creates this folder on every run)
reviewagent-fresh/
reviewagent-fresh.old.*/

# macOS desktop build output
desktop-app/build/

# Windows 桌面版：记住上次选的仓库路径，属于本机状态
desktop-app/win/last_repo.txt
desktop-app/win/__pycache__/
